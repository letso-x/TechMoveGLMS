@model TechMoveGLMS.Models.Contract

@{
    ViewData["Title"] = "Details";
}

<h1>Contract Details</h1>

<div>
    <h4>Contract</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.StartDate)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.StartDate)
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.EndDate)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.EndDate)
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Status)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Status)
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            Signed Agreement
        </dt>
        <dd class = "col-sm-10">
            @if (!string.IsNullOrEmpty(Model.SignedAgreement))
            {
                <!-- download link for pdf -->
                <a href="@Url.Action("Download", "Contracts", new { id = Model.Id })" class="btn btn-sm btn-primary">
                    Download PDF
                </a>
                <span class="ml-2">(@Model.SignedAgreement)</span>
            }
            else
            {
                <span>No file uploaded</span>
            }
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.ServiceLevel)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.ServiceLevel)
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.ClientId)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.ClientId)
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-warning">Edit</a> |
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>
