@model TechMoveGLMS.Models.Contract

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit Contract</h1>

<h4>Contract</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <!-- form for editing contract, allows file upload -->
        <form asp-action="Edit" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />

            <div class="form-group">
                <label asp-for="StartDate" class="control-label"></label>
                <input asp-for="StartDate" class="form-control" />
                <span asp-validation-for="StartDate" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="EndDate" class="control-label"></label>
                <input asp-for="EndDate" class="form-control" />
                <span asp-validation-for="EndDate" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Status" class="control-label"></label>
                <input asp-for="Status" class="form-control" />
                <span asp-validation-for="Status" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label class="control-label">Current Agreement</label>
                @if (!string.IsNullOrEmpty(Model.SignedAgreement))
                {
                    <p>
                        <a href="@Url.Action("Download", "Contracts", new { id = Model.Id })" target="_blank">
                            Download: @Model.SignedAgreement
                        </a>
                    </p>
                }
                else
                {
                    <p>No file uploaded</p>
                }
            </div>

            <div class="form-group">
                <label for="pdfFile" class="control-label">Upload New Signed Agreement (PDF) - Optional</label>
                <!-- file input for replacing pdf -->
                <input type="file" id="pdfFile" name="pdfFile" class="form-control" accept=".pdf" />
                <small class="form-text text-muted">Only PDF files allowed. Leave empty to keep current file.</small>
            </div>

            <div class="form-group">
                <label asp-for="ServiceLevel" class="control-label"></label>
                <input asp-for="ServiceLevel" class="form-control" />
                <span asp-validation-for="ServiceLevel" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="ClientId" class="control-label"></label>
                <input asp-for="ClientId" class="form-control" />
                <span asp-validation-for="ClientId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

